{
  "private": true,
  "scripts": {
    "start": "dotnet fable src/Client --outDir src/Client/output --watch --run npx vite",
    "build": "dotnet fable src/Client --outDir src/Client/output --noCache && npx vite build",
    "test:auto-sync-ui": "dotnet test src/Tests/Tests.fsproj --filter \"Category=AutoSyncUiVerification\" --logger \"console;verbosity=detailed\"",
    "test:extension": "node --test src/Extension/*.test.mjs src/Extension/reporting/*.test.mjs",
    "test:reporting": "node --test src/Extension/reporting/*.test.mjs",
    "test:durable-terminal-host": "node --test scripts/durable-terminal-host.test.mjs",
    "test:durable-terminal-observation": "node --test scripts/durable-terminal-observation.test.mjs",
    "test:durable-terminal-verifier-env": "node --test scripts/durable-terminal-verifier-env.test.mjs",
    "test:ttyd-runtime-unit": "node --test scripts/verify-ttyd-runtime.test.mjs",
    "test:durable-terminal-runtime": "node scripts/verify-durable-terminal-runtime.mjs",
    "test:durable-terminal-treemon": "node scripts/verify-durable-terminal-treemon.mjs",
    "test:ttyd-runtime": "node scripts/verify-ttyd-runtime.mjs",
    "terminal:observation:start": "node scripts/durable-terminal-observation.mjs start",
    "terminal:observation:status": "node scripts/durable-terminal-observation.mjs status",
    "terminal:observation:stop": "node scripts/durable-terminal-observation.mjs stop"
  },
  "devDependencies": {
    "gifsicle": "^7.0.1",
    "playwright": "1.58.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ws": "8.21.3"
  }
}
