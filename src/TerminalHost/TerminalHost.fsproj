<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TerminalHost</AssemblyName>
    <RootNamespace>TerminalHost</RootNamespace>
    <RollForward>LatestMajor</RollForward>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="ResilientMailbox.fs" />
    <Compile Include="LoopbackHost.fs" />
    <Compile Include="PathValidation.fs" />
    <Compile Include="JobProcess.fs" />
    <Compile Include="TerminalProtocol.fs" />
    <Compile Include="RequestSecurity.fs" />
    <Compile Include="TerminalDataPlane.fs" />
    <Compile Include="TerminalProxy.fs" />
    <Compile Include="TerminalLauncher.fs" />
    <Compile Include="TerminalRegistry.fs" />
    <Compile Include="Manifest.fs" />
    <Compile Include="ControlApi.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerminalHostLayout\TerminalHostLayout.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\.tools\ttyd\1.7.7\ttyd.exe"
          Condition="'$(OS)' == 'Windows_NT'"
          Link="ttyd.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\.tools\ttyd\1.7.7\LICENSE.txt"
          Condition="'$(OS)' == 'Windows_NT'"
          Link="ttyd-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateTerminalHostDependencies"
          BeforeTargets="Build;Publish">
    <Error Condition="'$(OS)' == 'Windows_NT' and !Exists('..\..\.tools\ttyd\1.7.7\ttyd.exe')"
           Text="The pinned ttyd runtime is missing. Run .\treemon.ps1 setup-ttyd before building TerminalHost." />
  </Target>

</Project>
