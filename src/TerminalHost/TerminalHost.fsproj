<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TerminalHost</AssemblyName>
    <RootNamespace>TerminalHost</RootNamespace>
    <RollForward>LatestMajor</RollForward>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="ResilientMailbox.fs" />
    <Compile Include="LoopbackHost.fs" />
    <Compile Include="PathValidation.fs" />
    <Compile Include="JobProcess.fs" />
    <Compile Include="TerminalProtocol.fs" />
    <Compile Include="RequestSecurity.fs" />
    <Compile Include="TerminalDataPlane.fs" />
    <Compile Include="TerminalProxy.fs" />
    <Compile Include="TerminalShell.fs" />
    <Compile Include="TerminalLauncher.fs" />
    <Compile Include="TerminalRegistry.fs" />
    <Compile Include="Manifest.fs" />
    <Compile Include="ControlApi.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerminalHostLayout\TerminalHostLayout.fsproj" />
  </ItemGroup>

  <PropertyGroup>
    <TtydVersion>1.7.7</TtydVersion>
    <TtydDirectory>$(MSBuildThisFileDirectory)../../.tools/ttyd/$(TtydVersion)/</TtydDirectory>
    <TtydExecutableName Condition="'$(OS)' == 'Windows_NT'">ttyd.exe</TtydExecutableName>
    <TtydExecutableName Condition="'$(OS)' != 'Windows_NT'">ttyd</TtydExecutableName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Guarded by Exists so a missing runtime is reported by ValidateTerminalHostDependencies
         below rather than as a bare MSB3030 copy failure. -->
    <None Include="$(TtydDirectory)$(TtydExecutableName)"
          Condition="Exists('$(TtydDirectory)$(TtydExecutableName)')"
          Link="$(TtydExecutableName)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(TtydDirectory)LICENSE.txt"
          Condition="Exists('$(TtydDirectory)LICENSE.txt')"
          Link="ttyd-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateTerminalHostDependencies"
          BeforeTargets="Build;Publish">
    <Error Condition="!Exists('$(TtydDirectory)$(TtydExecutableName)')"
           Text="The pinned ttyd runtime is missing from $(TtydDirectory). Run 'treemon.cmd setup-ttyd' on Windows or './treemon.sh setup-ttyd' elsewhere, then build again." />
  </Target>

</Project>
